---
import Section from "../Section.astro"
import { education } from "@cv"

---

<Section title="Educación">
  <ul class="grid grid-cols-1 gap-2">
    {education.map(({ institution, area, startDate, endDate }) => (
      <li class="">
        <h3 class="text-lg font-bold">{area}</h3>
        <p class="text-sm">{
          institution
        }</p>
        <p class="text-sm">{
          startDate
        } - {
          endDate
        }</p>
      </li>
    ))}
</Section>