---
import { basics } from "@cv";
const { profiles } = basics;

// Social media icons
const SOCIAL_ICONS = {
  Github: `<svg
              xmlns="http://www.w3.org/2000/svg"
              style="margin-right: 8px"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"
              ></path></svg
            >`,
  Linkedin: `<svg
  xmlns="http://www.w3.org/2000/svg"
  style="margin-right: 8px"
              width="18"
              height="18"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="icon icon-tabler icons-tabler-outline icon-tabler-brand-linkedin"
  ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
    d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"
  ></path><path d="M8 11l0 5"></path><path d="M8 8l0 .01"></path><path
    d="M12 16l0 -5"></path><path d="M16 16v-3a2 2 0 0 0 -4 0"></path></svg
>`,
  Twitter: `<svg
  xmlns="http://www.w3.org/2000/svg"
  style="margin-right: 8px"
              width="18"
              height="18"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="icon icon-tabler icons-tabler-outline icon-tabler-brand-twitter"
  ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
    d="M22 4.01c-1 .49 -1.98 .689 -3 .99c-1.121 -1.265 -2.783 -1.335 -4.38 -.737s-2.643 2.06 -2.62 3.737v1c-3.245 .083 -6.135 -1.395 -8 -4c0 0 -4.182 7.433 4 11c-1.872 1.247 -3.739 2.088 -6 2c3.308 1.803 6.913 2.423 10.034 1.517c3.58 -1.04 6.522 -3.723 7.651 -7.742a13.84 13.84 0 0 0 .497 -3.753c0 -.249 1.51 -2.772 1.818 -4.013z"
  ></path></svg
>`,
  Telegram: `<svg
  xmlns="http://www.w3.org/2000/svg"
  style="margin-right: 8px"
              width="18"
              height="18"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="icon icon-tabler icons-tabler-outline icon-tabler-brand-telegram"
  ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
    d="M15 10l-4 4l6 6l4 -16l-18 7l4 2l2 6l3 -4"></path></svg
>`,
  WhatsApp: `<svg
  xmlns="http://www.w3.org/2000/svg"
  style="margin-right: 8px"
              width="18"
              height="18"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="icon icon-tabler icons-tabler-outline icon-tabler-brand-whatsapp"
  ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
    d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"></path><path
    d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"
  ></path></svg
>`,
};

const profilesInfo = profiles.map(({ network, url }) => {
  const icon = SOCIAL_ICONS[network];
  let firstLetter = network.charAt(0).toUpperCase();
  if (network === "Twitter") {
    firstLetter = "X";
  }
  return {
    section: "Social",
    title: network,
    url,
    icon,
    hotkey: `Ctrl + ${firstLetter === "T" || firstLetter === "W" ? `Alt + ${firstLetter}` : firstLetter}`,
  };
});
---

<footer
  class="noPrint bg-[#e4e4e4] mt-1 pb-1 text-center fixed -bottom-0.5 w-full text-[#4031c4]"
>
  Pulsa <kbd>Ctrl</kbd> + <kbd>k</kbd> o <kbd>Cmd</kbd> + <kbd>k</kbd> para abrir
  la paleta de comandos. <br />
</footer>
<ninja-keys data-info={JSON.stringify(profilesInfo)} placeholder="Buscar comando" hideBreadcrumb></ninja-keys>

<script>
  import "ninja-keys";
  const ninjaKeys = document.querySelector("ninja-keys");

  if (ninjaKeys) {
    const info = ninjaKeys.getAttribute("data-info") ?? "[]";
    const profiles = JSON.parse(info);
    const data = profiles.map(({ section, title, url, hotkey, icon }) => {
      return {
        id: title,
        title: `Visitar ${title}`,
        hotkey,
        section,
        icon,
        handler: () => {
          window.open(url, "_blank");
        },
      };
    });
    profiles.forEach(({ title }) => {
      const firstLetter = title.charAt(0).toUpperCase();
      document.addEventListener("keydown", (event) => {
        if (event.ctrlKey && event.key === firstLetter) {
          event.preventDefault();
        }
      });
    });
    
    ninjaKeys.data = [
      {
        id: "print",
        title: "Imprimir",
        hotkey: "Ctrl + P",
        icon: `<svg
                  style="margin-right: 8px"
                  width="18"
                  height="18"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0 0 21 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 0 0-1.913-.247M6.34 18H5.25A2.25 2.25 0 0 1 3 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 0 1 1.913-.247m10.5 0a48.536 48.536 0 0 0-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5Zm-3 0h.008v.008H15V10.5Z"
                  ></path>
                </svg>`,
        section: "Acciones",
        handler: () => {
          window.print();
        },
      },
      {
        id: "toggle",
        title: "Mostrar QRs",
        hotkey: "Ctrl + Q",
        section: "Acciones",
        icon: `<svg
                xmlns="http://www.w3.org/2000/svg"
                style="margin-right: 8px"
                width="18"
                height="18"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5ZM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5ZM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 13.5 9.375v-4.5Z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M6.75 6.75h.75v.75h-.75v-.75ZM6.75 16.5h.75v.75h-.75v-.75ZM16.5 6.75h.75v.75h-.75v-.75ZM13.5 13.5h.75v.75h-.75v-.75ZM13.5 19.5h.75v.75h-.75v-.75ZM19.5 13.5h.75v.75h-.75v-.75ZM19.5 19.5h.75v.75h-.75v-.75ZM16.5 16.5h.75v.75h-.75v-.75Z"
                ></path>
              </svg>`,
        handler: () => {
          const QRs = document.getElementById("QRs");
          QRs?.classList.toggle("QRsFlex");
          QRs?.classList.toggle("QRsHidden");
        },
      },
      ...data,
    ];
  }
</script>

<style>
  @media print {
    ninja-keys {
      display: none;
    }
    .noPrint {
      display: none;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
    
  }

  footer {
    view-timeline-name: --revealing;
    view-timeline-axis: block;
    animation: linear 0.3s fadeIn;
    animation-timeline: --revealing;
    animation-range: entry 90% cover 10%;
  }

  kbd {
    background: #fdfdfd;
    border-radius: 4px;
    padding: 2px 8px;
    box-shadow: 5px 4px 3px rgba(0, 0, 0, 0.1);
    font-size: 16px;
  }
</style>
